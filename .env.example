# Postgres-Verbindung (lokal oder Neon/Vercel Postgres)
DATABASE_URL="postgresql://user:passwort@host:5432/tippspiel"

# Geheimnis zum Signieren der Login-Sessions (z. B. mit `openssl rand -base64 32` erzeugen)
AUTH_SECRET="bitte-ersetzen"

# --- Optional: automatischer Resultat-Sync ---
# Gratis-Key von https://www.football-data.org/client/register (WM im Free-Tier).
# Ohne Key werden Resultate manuell im Admin-Bereich erfasst.
FOOTBALL_DATA_API_KEY=""
# Schützt /api/cron/sync (beliebige zufällige Zeichenkette)
CRON_SECRET=""

# --- Optional: Bot-Schutz bei der Registrierung (Cloudflare Turnstile, gratis) ---
# Keys unter https://dash.cloudflare.com → Turnstile erstellen.
# Ohne Keys läuft die Registrierung ohne Captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
